<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>NextGen QA · Test Execution Report · {{ run.id }}</title>
  <style>
    @page { size: A4; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      color: #0f172a; font-size: 10.5pt; line-height: 1.5;
    }
    h1 { font-size: 22pt; margin: 0 0 2pt; letter-spacing: -0.4pt; }
    h2 { font-size: 13pt; margin: 22pt 0 10pt; }
    .muted { color: #64748b; }
    .break { page-break-before: always; }
    code {
      font-family: "JetBrains Mono", Menlo, Consolas, monospace; font-size: 9pt;
      background: #f1f5f9; padding: 1pt 5pt; border-radius: 3pt;
    }

    /* Title band */
    .titlebar {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding-bottom: 14pt; border-bottom: 2px solid #4f46e5; margin-bottom: 18pt;
    }
    .kicker {
      font-size: 8.5pt; font-weight: 700; letter-spacing: 1pt;
      text-transform: uppercase; color: #4f46e5;
    }
    .sub { color: #64748b; font-size: 9.5pt; margin-top: 6pt; }
    .status-pill {
      display: inline-block; padding: 6pt 16pt; border-radius: 999pt;
      font-weight: 700; font-size: 10pt; letter-spacing: 0.5pt; white-space: nowrap;
    }
    .status-passed { background: #d1fae5; color: #065f46; }
    .status-failed { background: #fee2e2; color: #991b1b; }
    .status-error  { background: #fef3c7; color: #92400e; }

    /* Summary tiles */
    .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10pt; margin: 16pt 0; }
    .tile { border: 1px solid #e2e8f0; border-radius: 10pt; padding: 12pt 14pt; }
    .tile .v { font-size: 20pt; font-weight: 700; }
    .tile .l { font-size: 8pt; color: #64748b; text-transform: uppercase; letter-spacing: 0.5pt; margin-top: 2pt; }
    .tile.accent { background: #eef2ff; border-color: #c7d2fe; }

    /* Donut + legend */
    .cols { display: grid; grid-template-columns: 190pt 1fr; gap: 24pt; align-items: center; margin: 6pt 0; }
    .donut { position: relative; width: 150pt; height: 150pt; margin: auto; }
    .donut svg { transform: rotate(-90deg); }
    .donut .pct {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; line-height: 1;
    }
    .donut .pct .n { font-size: 24pt; font-weight: 700; line-height: 1; }
    .donut .pct .t { font-size: 7.5pt; color: #64748b; text-transform: uppercase; letter-spacing: 0.5pt; margin-top: 5pt; line-height: 1; }
    .legend .row { display: flex; align-items: center; gap: 8pt; margin: 6pt 0; font-size: 10.5pt; }
    .legend .sw { width: 10pt; height: 10pt; border-radius: 3pt; flex-shrink: 0; }

    /* Metadata table */
    .kv { width: 100%; border-collapse: collapse; font-size: 10pt; margin-top: 4pt; }
    .kv td { padding: 6pt 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    .kv td.k { color: #64748b; width: 150pt; }

    /* Screenshots */
    .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 12pt; margin-top: 6pt; }
    .shot { border: 1px solid #e2e8f0; border-radius: 8pt; overflow: hidden; page-break-inside: avoid; }
    .shot.failed { border-color: #fecaca; }
    .shot img { width: 100%; height: 110pt; object-fit: cover; display: block; background: #f8fafc; }
    .shot .cap { padding: 5pt 9pt; font-size: 8.5pt; display: flex; justify-content: space-between; align-items: center; }
    .badge { font-size: 7.5pt; font-weight: 700; padding: 2pt 8pt; border-radius: 999pt; text-transform: uppercase; letter-spacing: 0.3pt; }
    .badge.ok  { background: #d1fae5; color: #065f46; }
    .badge.bad { background: #fee2e2; color: #991b1b; }

    pre.log {
      background: #0f172a; color: #e2e8f0; padding: 12pt 14pt; border-radius: 8pt;
      font-family: "JetBrains Mono", Menlo, monospace; font-size: 8pt; line-height: 1.55;
      white-space: pre-wrap; word-break: break-all; margin-top: 6pt;
    }
  </style>
</head>
<body>

  {# ── Summary ─────────────────────────────────────────────────────────── #}
  <section>
    <div class="titlebar">
      <div>
        <div class="kicker">NextGen QA · Component 2 · Intelligent Test Case Generation</div>
        <h1>Test Execution Report</h1>
        <div class="sub">Run <code>{{ run.id }}</code> &middot; {{ run.framework }} &middot; {{ run.mode }} mode</div>
      </div>
      <span class="status-pill status-{{ run.status }}">{{ run.status|upper }}</span>
    </div>

    <div class="tiles">
      <div class="tile accent"><div class="v" style="color:#4f46e5;">{{ pass_pct }}%</div><div class="l">Pass Rate</div></div>
      <div class="tile"><div class="v">{{ run.total_count }}</div><div class="l">Total Scenarios</div></div>
      <div class="tile"><div class="v" style="color:#059669;">{{ run.passed_count }}</div><div class="l">Passed</div></div>
      <div class="tile"><div class="v" style="color:#dc2626;">{{ run.failed_count }}</div><div class="l">Failed</div></div>
    </div>

    <div class="cols">
      <div class="donut">
        {% set radius = 62 %}
        {% set circ = 2 * 3.14159 * radius %}
        {% set passed_arc = circ * (run.passed_count / (run.total_count if run.total_count else 1)) %}
        <svg width="150" height="150" viewBox="0 0 150 150">
          <circle cx="75" cy="75" r="{{ radius }}" stroke="#fee2e2" stroke-width="16" fill="none" />
          <circle cx="75" cy="75" r="{{ radius }}" stroke="#10b981" stroke-width="16" fill="none"
                  stroke-dasharray="{{ passed_arc }} {{ circ }}" stroke-linecap="round" />
        </svg>
        <div class="pct"><span class="n">{{ pass_pct }}%</span></div>
      </div>
      <div class="legend">
        <div class="row"><span class="sw" style="background:#10b981"></span><strong>{{ run.passed_count }}</strong>&nbsp;Passed scenarios</div>
        <div class="row"><span class="sw" style="background:#ef4444"></span><strong>{{ run.failed_count }}</strong>&nbsp;Failed scenarios</div>
        <div class="row"><span class="sw" style="background:#cbd5e1"></span><strong>{{ run.duration_ms|fdur }}</strong>&nbsp;Total duration</div>
      </div>
    </div>

    <h2>Pipeline Metadata</h2>
    <table class="kv">
      <tr><td class="k">Project ID</td><td><code>{{ run.project_id }}</code></td></tr>
      {% if suite %}
      <tr><td class="k">Test Suite</td><td>{{ suite.filename }} &middot; version {{ suite.version }}</td></tr>
      <tr><td class="k">Generation Mode</td><td>{{ "Mode B — DOM-Aware" if suite.mode == "dom" else "Mode A — Abstract" }}</td></tr>
      <tr><td class="k">Target URL</td><td><code>{{ suite.url }}</code></td></tr>
      {% endif %}
      <tr><td class="k">Framework</td><td>{{ run.framework }}</td></tr>
      <tr><td class="k">Execution Mode</td><td>{{ run.mode }}{% if run.github_branch %} &middot; {{ run.github_branch }}{% endif %}</td></tr>
      <tr><td class="k">Started</td><td>{{ run.started_at|fdt }}</td></tr>
      <tr><td class="k">Finished</td><td>{{ run.finished_at|fdt }}</td></tr>
      {% if run.github_run_url %}
      <tr><td class="k">CI Run</td><td><code>{{ run.github_run_url }}</code></td></tr>
      {% endif %}
    </table>
  </section>

  {# ── Screenshots ─────────────────────────────────────────────────────── #}
  {% if screenshots %}
  <section class="break">
    <h2>Captured Screenshots</h2>
    <p class="muted" style="font-size:9.5pt;margin:0;">Frames captured by the runner during each scenario.</p>
    <div class="shots">
      {% for s in screenshots %}
      <div class="shot {{ 'failed' if s.status == 'failed' else '' }}">
        {% if s.src %}<img src="{{ s.src }}" alt="{{ s.label }}" />{% else %}<div style="height:110pt;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:8pt;">no image</div>{% endif %}
        <div class="cap">
          <span>{{ s.label }}</span>
          <span class="badge {{ 'bad' if s.status == 'failed' else 'ok' }}">{{ s.status }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ── Execution log ───────────────────────────────────────────────────── #}
  <section class="break">
    <h2>Execution Log</h2>
    <p class="muted" style="font-size:9.5pt;margin:0;">Last 200 lines. The full log is archived in the database and downloadable from the dashboard.</p>
    <pre class="log">
{%- set lines = (run.raw_log_text or '').splitlines() -%}
{{ '\n'.join(lines[-200:]) if lines else 'No log output captured.' }}
    </pre>
  </section>

</body>
</html>
