{
  "name": "intelligent-test-case-generation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2"
  },
  "lint-staged": {
    "frontend/**/*.{js,ts,jsx,tsx}": [
      "pnpm --filter frontend exec eslint --fix"
    ],
    "backend/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  }
}
